# Server env vars (Render/Production)
NODE_ENV=production
PORT=5000

# Set this to your deployed frontend URL (Vercel)
CLIENT_URL=https://YOUR-VERCEL-DOMAIN.vercel.app

# JWT signing secret (use a long random string)
JWT_SECRET=replace_me_with_long_random

# Database
# Recommended: Turso
DATABASE_URL=libsql://YOUR_DB.turso.io
TURSO_AUTH_TOKEN=YOUR_TURSO_AUTH_TOKEN

# Alternatively (not recommended for persistence on free hosts)
# DATABASE_URL=file:./dev.db

# Uploads (recommended)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
