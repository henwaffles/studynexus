# Server env vars (Render/Production)
NODE_ENV=production
PORT=5000

# Set this to your deployed frontend URL (Vercel)
CLIENT_URL=https://YOUR-VERCEL-DOMAIN.vercel.app

# JWT signing secret (use a long random string)
JWT_SECRET=replace_me_with_long_random

# Database
# Prisma (schema) uses a SQLite datasource, so DATABASE_URL must be file:...
# In production with Turso, keep DATABASE_URL as a dummy file URL for Prisma CLI validation
# and set TURSO_DATABASE_URL for the runtime libsql connection.
DATABASE_URL=file:./dev.db

# Recommended: Turso (persistent)
TURSO_DATABASE_URL=libsql://YOUR_DB.turso.io
TURSO_AUTH_TOKEN=YOUR_TURSO_AUTH_TOKEN

# Uploads (recommended)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
